# ===========================================
# TELEGRAM BOT CONFIGURATION
# ===========================================

# Telegram Bot Token
# Ottienilo da @BotFather su Telegram
BOT_TOKEN=your_bot_token_here

# Esempio:
# BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# ===========================================
# OLLAMA AI CONFIGURATION (Opzionale)
# ===========================================

# URL Ollama API
# - Se Ollama è sullo stesso server del bot: http://localhost:11434/api/generate
# - Se Ollama è su Raspberry Pi separato: http://IP_RASPBERRY:11434/api/generate
OLLAMA_API_URL=http://localhost:11434/api/generate

# Modello Ollama da usare
# Consigliati per Raspberry Pi:
# - mistral:7b (buona qualità, 4GB RAM)
# - llama3.2:3b (veloce, 2GB RAM)
# - llama3.2:1b (ultra-leggero, 1GB RAM)
OLLAMA_MODEL=mistral:7b

# Abilita/disabilita AI (true/false)
AI_ENABLED=true

# ===========================================
# SUPABASE DATABASE (Opzionale)
# ===========================================

# Supabase Project URL e API Key
# Ottienili dal dashboard Supabase: https://app.supabase.com
# Lascia vuoto se non usi Supabase
SUPABASE_URL=
SUPABASE_KEY=

# Esempio:
# SUPABASE_URL=https://abcdefgh.supabase.co
# SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
